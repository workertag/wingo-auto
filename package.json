{
  "name": "wingo-automation",
  "version": "1.0.0",
  "description": "Wingo automation login bot",
  "main": "wingo-bot.js",
  "scripts": {
    "start": "node wingo-bot.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && node server.js",
    "dev:frontend": "cd frontend && bun dev"
  },
  "dependencies": {
    "playwright": "^1.40.0",
    "playwright-extra": "^4.3.6",
    "proxy-chain": "^2.3.0",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "user-agents": "^1.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
